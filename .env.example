# Runtime connection uses the restricted role (RLS enforced). Never use a superuser here.
DATABASE_URL=postgres://optistore_app:change-me@localhost:5432/optistore
# Used only to run migrations (owner/superuser)
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/optistore

PORT=3000
JWT_SECRET=replace-with-64+-random-chars-generated-by-openssl-rand-hex-32
JWT_TTL=15m
# 32 bytes hex. Generate: openssl rand -hex 32. Store in a secret manager / KMS in production.
ENCRYPTION_KEY=replace-with-64-hex-chars
PAYMENT_WEBHOOK_SECRET=replace-with-32+-random-chars
# Take rate in basis points (500 = 5%). PLACEHOLDER: the business must define pricing.
TAKE_RATE_BPS=500
# Platform admins must also enroll MFA to receive the admin claim
PLATFORM_ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:3001
