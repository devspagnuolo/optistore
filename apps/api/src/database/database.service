import { Injectable, OnModuleDestroy } from '@nestjs/common';
import { Pool, PoolClient, types } from 'pg';
import { ConfigService } from '../common/config';

// BIGINT (money in cents) -> number. Safe up to 2^53 cents (~90 trillion BRL); fail loudly beyond.
types.setTypeParser(20, (v) => {
  const n = Number(v);
  if (!Number.isSafeInteger(n)) throw new Error('bigint out of safe range');
  return n;
});

export interface TenantCtx {
  companyId?: string | null;
  userId?: string | null;
  /** Bypasses tenant policies. Only for auth flows and signed webhooks. Never from request input. */
  system?: boolean;
}

@Injectable()
export class DatabaseService implements OnModuleDestroy {
  readonly pool: Pool;

  constructor(cfg: ConfigService) {
    this.pool = new Pool({ connectionString: cfg.cfg.databaseUrl, max: 20, idleTimeoutMillis: 30_000 });
  }

  /** Runs fn in a transaction with the tenant context set for RLS (transaction-local settings). */
  async tx<T>(ctx: TenantCtx, fn: (c: PoolClient) => Promise<T>): Promise<T> {
    const client = await this.pool.connect();
    try {
      await client.query('BEGIN');
      await client.query(
        `SELECT set_config('app.company_id', $1, true),
                set_config('app.user_id',    $2, true),
                set_config('app.system',     $3, true)`,
        [ctx.companyId ?? '', ctx.userId ?? '', ctx.system ? 'on' : ''],
      );
      const out = await fn(client);
      await client.query('COMMIT');
      return out;
    } catch (e) {
      await client.query('ROLLBACK').catch(() => undefined);
      throw e;
    } finally {
      client.release();
    }
  }

  async ping(): Promise<boolean> {
    await this.pool.query('SELECT 1');
    return true;
  }

  onModuleDestroy() { return this.pool.end(); }
}
