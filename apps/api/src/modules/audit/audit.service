import { Injectable } from '@nestjs/common';
import type { PoolClient } from 'pg';
import { computeAuditHash, GENESIS_HASH } from '../../common/audit-hash';

export interface Actor { companyId?: string | null; userId?: string | null }

@Injectable()
export class AuditService {
  /**
   * Appends to the hash chain INSIDE the caller's transaction, so the audit row commits
   * atomically with the business change. Call it last in the transaction: the advisory lock
   * serializes chain writers until commit (acceptable for MVP; move to async outbox at scale).
   */
  async record(c: PoolClient, actor: Actor, action: string, entity?: string, entityId?: string, payload: unknown = {}) {
    await c.query(`SELECT pg_advisory_xact_lock(hashtextextended('optistore.audit_chain', 0))`);
    const last = await c.query<{ hash: string }>('SELECT hash FROM audit_log ORDER BY seq DESC LIMIT 1');
    const prev = last.rows[0]?.hash ?? GENESIS_HASH;
    const entry = {
      at: new Date().toISOString(),
      companyId: actor.companyId ?? null,
      userId: actor.userId ?? null,
      action,
      entity: entity ?? null,
      entityId: entityId ?? null,
      payload,
    };
    await c.query(
      `INSERT INTO audit_log (at, company_id, user_id, action, entity, entity_id, payload, prev_hash, hash)
       VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)`,
      [entry.at, entry.companyId, entry.userId, action, entry.entity, entry.entityId,
       JSON.stringify(payload), prev, computeAuditHash(prev, entry)],
    );
  }
}
